{
  "name": "jobradar",
  "version": "1.0.0",
  "private": true,
  "description": "JobRadar: remote jobs for people in Vietnam. Server, user app and admin app in one repository.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "server",
    "frontend/shared",
    "frontend/client",
    "frontend/admin"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/server.js",
    "dev:server": "npm --workspace @jobradar/server run start",
    "dev:client": "npm --workspace @jobradar/client run dev",
    "dev:admin": "npm --workspace @jobradar/admin run dev",
    "build": "npm --workspace @jobradar/client --workspace @jobradar/admin run build",
    "fetch": "npm --workspace @jobradar/server run fetch",
    "migrate": "npm --workspace @jobradar/server run migrate",
    "telegram:chatid": "npm --workspace @jobradar/server run telegram:chatid"
  }
}
