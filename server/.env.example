# Copy this file to .env and fill in the values. On Render, set the same
# variables under Environment instead (never commit .env).

# Postgres connection string from Neon (Dashboard -> Connect, pooled connection).
# Use a database of its own, not the one your other site uses.
DATABASE_URL=

# Password for the web page. Required when the server is online (Render).
# Leave empty only for local use on your own machine.
APP_PASSWORD=
# Optional: a long random string that signs the login cookie. Changing it
# logs every browser out. If empty, APP_PASSWORD is used.
SESSION_SECRET=

# Secret for the cron job that triggers scans: GET/POST /api/cron/scan with
# the header "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=

# Public address of the site, used in Telegram links, e.g. https://jobradar.onrender.com
PUBLIC_URL=

# Get the token from @BotFather on Telegram, then run: npm run telegram:chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free Google AI Studio key (aistudio.google.com -> Get API key), on a project
# with NO billing account attached, so it stays in the free tier.
GEMINI_API_KEY=

# ---- Accounts (the new app at /app/ and the admin at /admin/) ----

# Emails that get admin rights, comma-separated (e.g. your own).
ADMIN_EMAILS=

# Sign in with Google: create an OAuth client (type "Web application") in
# Google Cloud Console -> APIs & Services -> Credentials. Authorised redirect URI:
#   <PUBLIC_URL>/api/auth/google/callback
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account emails (verify address, reset password) through resend.com.
# EMAIL_FROM must use a domain verified in Resend, e.g. JobRadar <noreply@your-domain>.
# Leave empty to send nothing (locally the link is printed in the server log).
RESEND_API_KEY=
EMAIL_FROM=

# Shown in the privacy policy and terms: who runs the service and how to reach them.
LEGAL_OPERATOR=
CONTACT_EMAIL=

# ---- Plans and Telegram for app users ----

# Payments: "mock" (default) shows a sample transfer and a test button that
# turns on Pro without moving money. Set to "live" only once real payment
# details are filled in below and payments are confirmed by an admin.
BILLING_MODE=mock
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# Public channel for the Free plan's daily digest. Add the bot as an admin of
# the channel. TELEGRAM_CHANNEL_ID is @name or the numeric id; the URL is the
# t.me link shown in the app. The digest goes out once a day after this hour
# (Vietnam time).
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=
CHANNEL_DIGEST_HOUR=8

# ---- Ads (Free plan, landing page, blog) ----
# Google AdSense publisher id (ca-pub-...) and ad unit ids per place. Without
# them, the slots show JobRadar's own promotion. Google's script loads only
# after a visitor accepts ads on the consent banner; Pro users see no ads.
ADSENSE_CLIENT=
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_POST=
ADSENSE_SLOT_BLOG=
ADSENSE_SLOT_LANDING=
