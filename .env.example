# Copy this file to .env and fill in the two values.
# Get the token from @BotFather on Telegram, then run: npm run telegram:chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free Google AI Studio key (aistudio.google.com -> Get API key), on a project
# with NO billing account attached, so it stays in the free tier.
GEMINI_API_KEY=
