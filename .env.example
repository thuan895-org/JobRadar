# Copy this file to .env and fill in the values. On Render, set the same
# variables under Environment instead (never commit .env).

# Postgres connection string from Neon (Dashboard -> Connect, pooled connection).
# Use a database of its own, not the one your other site uses.
DATABASE_URL=

# Password for the web page. Required when the server is online (Render).
# Leave empty only for local use on your own machine.
APP_PASSWORD=
# Optional: a long random string that signs the login cookie. Changing it
# logs every browser out. If empty, APP_PASSWORD is used.
SESSION_SECRET=

# Secret for the cron job that triggers scans: GET/POST /api/cron/scan with
# the header "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=

# Public address of the site, used in Telegram links, e.g. https://jobradar.onrender.com
PUBLIC_URL=

# Get the token from @BotFather on Telegram, then run: npm run telegram:chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free Google AI Studio key (aistudio.google.com -> Get API key), on a project
# with NO billing account attached, so it stays in the free tier.
GEMINI_API_KEY=
